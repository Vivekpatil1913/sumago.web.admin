{
  "name": "sumago-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"api,web\" --prefix-colors \"magenta,cyan\" --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "next dev -p 3100",
    "dev:api": "npm --prefix ../sumago-website-backend run dev",
    "build:images": "node scripts/build-image-assets.mjs",
    "build": "next build",
    "build:all": "npm --prefix ../sumago-website-backend run build && next build",
    "start": "concurrently --names \"api,web\" --prefix-colors \"magenta,cyan\" \"npm:start:api\" \"npm:start:web\"",
    "start:web": "next start -p 3100",
    "start:api": "npm --prefix ../sumago-website-backend run start",
    "db:migrate": "npm --prefix ../sumago-website-backend run migrate",
    "db:seed": "npm --prefix ../sumago-website-backend run seed",
    "setup": "npm --prefix ../sumago-website-backend install && npm run db:migrate && npm run db:seed",
    "test:api": "npm --prefix ../sumago-website-backend test",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "aos": "^2.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "simple-icons": "^16.25.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/aos": "^3.0.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prettier": "^3.9.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
